# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# SMTP CREDENTIALS DISPATCHER (For live email delivery to students' inboxes)
# =========================================================================
# If configured in your local .env, the system delivers credentials directly
# to external Gmail / Yahoo / Outlook student inboxes.
# If omitted, emails are saved locally in the Portal Outbox (/data/emails.json).
#
# Option A: Google Gmail (Recommended for testing & small centres)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password into SMTP_PASS below:
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="HiiT CBT Assessment Centre <your-email@gmail.com>"
BREVO_API_KEY="your-brevo-api-key-here"


# Option B: Standard SMTP (Brevo, SendGrid, Mailgun, Outlook, cPanel)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-login"
# SMTP_PASS="your-smtp-key"
# SMTP_FROM="HiiT Assessment Portal <portal@hiit.ng>"

